# ==================================
# Copy this file to ".env" and change
# the values before running the app.
# The defaults below work fine for
# trying the project out locally.
# ==================================

# --- Application ---
NODE_ENV=production
PORT=3001

# --- PostgreSQL ---
# Inside Docker, the backend always talks to the "postgres" service by name —
# DATABASE_HOST is overridden automatically in docker-compose.yml.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=kanban
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- JWT ---
# IMPORTANT: change this to a long, random string before you share this
# app with anyone else. Anyone who knows this secret can forge login tokens.
JWT_SECRET=change-this-secret-before-going-live
JWT_EXPIRES_IN=1d

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cache ---
# How long (in seconds) a cached API response is kept before it expires.
CACHE_TTL_SECONDS=300

# --- CORS ---
# The web address the frontend runs at. Only this address is allowed to
# call the API from a browser.
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
# The web address the frontend uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
